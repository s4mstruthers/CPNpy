<?xml version="1.0" encoding="UTF-8"?>
<pnml>
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/pnmlcoremodel">
    <name><text>net</text></name>
    <page id="page1">
      <place id="i"><name><text>i</text></name><initialMarking><text>1</text></initialMarking><graphics><position x="40.0" y="160.0"/><dimension x="40" y="40"/></graphics></place>
      <place id="o"><name><text>o</text></name><graphics><position x="680.0" y="160.0"/><dimension x="40" y="40"/></graphics></place>
      <place id="c1"><name><text>c1</text></name><graphics><position x="200.0" y="160.0"/><dimension x="40" y="40"/></graphics></place>
      <place id="c2"><name><text>c2</text></name><graphics><position x="400.0" y="100.0"/><dimension x="40" y="40"/></graphics></place>
      <place id="c3"><name><text>c3</text></name><graphics><position x="400.0" y="220.0"/><dimension x="40" y="40"/></graphics></place>
      <transition id="t_register"><name><text>register</text></name><graphics><position x="120.0" y="160.0"/><dimension x="40" y="40"/></graphics></transition>
      <transition id="t_send_letter"><name><text>send letter</text></name><graphics><position x="300.0" y="100.0"/><dimension x="40" y="40"/></graphics></transition>
      <transition id="t_call_customer"><name><text>call customer</text></name><graphics><position x="300.0" y="220.0"/><dimension x="40" y="40"/></graphics></transition>
      <transition id="t_archive"><name><text>archive</text></name><graphics><position x="520.0" y="160.0"/><dimension x="40" y="40"/></graphics></transition>
      <arc id="arc1" source="i" target="t_register"></arc>
      <arc id="arc2" source="t_register" target="c1"></arc>
      <arc id="arc3" source="c1" target="t_send_letter"></arc>
      <arc id="arc4" source="c1" target="t_call_customer"></arc>
      <arc id="arc5" source="t_send_letter" target="c2"></arc>
      <arc id="arc6" source="t_call_customer" target="c3"></arc>
      <arc id="arc7" source="c2" target="t_archive"></arc>
      <arc id="arc8" source="c3" target="t_archive"></arc>
      <arc id="arc9" source="t_archive" target="o"></arc>
    </page>
    <finalmarkings><marking>
      <place idref="o"><text>1</text></place>
    </marking></finalmarkings>
  </net>
</pnml>
