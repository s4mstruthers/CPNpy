                <ml id='ID5534329181'>
                    fun insertB2F (id,r,s) [] = [(id,r,s)]   |   insertB2F (id,r,s) ((id2,r2,s2)::l) =if (id2 mod 10 = 0) then (id2,r2,s2)::(insertB2F (id,r,s) l)else if (r2 &lt; r)      then (id,r,s)::(id2,r2,s2)::l     else (id2,r2,s2)::(insertB2F (id,r,s) l);
                </ml>
                <ml id='ID5537505508'>
                    fun insertRND (id,r,s) l = (id,r,s)::l;
                </ml>
                <ml id='ID5537546426'>
                    fun insertBlock (id,r,s) [] = [(id,r,s)]   |   insertBlock (id,r,s) ((id2,r2,s2)::l) =if (id2 mod 10 = 0) then (id2,r2,s2)::(insertBlock (id,r,s) l)else if (r2 div 7)&lt;(r div 7) then (id,r,s)::(id2,r2,s2)::l     else (id2,r2,s2)::(insertBlock (id,r,s) l);
                </ml>
                <ml id='ID5538200834'>
                    fun insertWilma (id,r,s) [] = [(id,r,s)]   |   insertWilma(id,r,s) ((id2,r2,s2)::l) =if (id2 mod 10 = 0) then (id2,r2,s2)::(insertWilma(id,r,s) l)else if (s2 mod 3) = (s mod 3) then if (r2 &lt; r) then (id,r,s)::(id2,r2,s2)::l else (id2,r2,s2)::(insertWilma(id,r,s) l)else if (s2 mod 3) &gt; (s mod 3) then  (id,r,s)::(id2,r2,s2)::l else (id2,r2,s2)::(insertWilma(id,r,s) l);
                </ml>
                <ml id='ID5542558590'>
                    fun insertSteffenImp (id,r,s) [] =
   [(id,r,s)]
|  insertSteffenImp (id,r,s) ((id2,r2,s2)::l) =
if (id2 mod 10 = 0) then (id2,r2,s2)::(insertSteffenImp (id,r,s) l) else
if ( ((r mod 2) &gt; (r2 mod 2)) orelse
     (((r mod 2) = (r2 mod 2)) andalso ((s div 3) &gt; (s2 div 3))) orelse 
     (((r mod 2) = (r2 mod 2)) andalso ((s div 3) = (s2 div 3)) andalso (r&lt; r2)) 
)
then (id2,r2,s2)::(insertSteffenImp (id,r,s) l)   
else ((id,r,s)::(id2,r2,s2)::l);
                </ml>
                <ml id='ID5561065886'>
                    fun insertSteffenOpt (id,r,s) [] =
   [(id,r,s)]|  insertSteffenOpt (id,r,s) ((id2,r2,s2)::l) =
if (id2 mod 10 = 0) then (id2,r2,s2)::(insertSteffenOpt (id,r,s) l) else if ( ((s mod 3) &gt; (s2 mod 3)) orelse
     (((s mod 3) = (s2 mod 3)) andalso ((r mod 2) &gt; (r2 mod 2))) orelse     (((s mod 3) = (s2 mod 3)) andalso ((r mod 2) = (r2 mod 2)) andalso s &gt; s2) orelse
    (((s mod 3) = (s2 mod 3)) andalso ((r mod 2) = (r2 mod 2)) andalso s = s2 andalso r &lt; r2) 
)then (id2,r2,s2)::(insertSteffenOpt (id,r,s) l)   else ((id,r,s)::(id2,r2,s2)::l);
                </ml>
